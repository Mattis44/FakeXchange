generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderRole {
  MAKER
  TAKER
}

model User {
  id       String   @id @default(uuid())
  username String   @unique
  balance  Float

  orders  Order[]
}

model Market {
  id          String   @id @default(uuid())
  symbol      String   @unique // e.g., "TESTUSD"
  base        String   // e.g., "TEST"
  quote       String   // e.g., "USD"
  lastPrice  Float  // Last traded price
  volume     Float?  // All-time volume
  orders     Order[]
  trades     Trade[]
  candles    Candle[]
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  marketId  String
  side      String   // e.g., "buy" or "sell"
  type      String   // e.g., "limit" or "market"
  price     Float
  size      Float
  remaining Float // Remaining size of the order
  status    String   // e.g., "open", "filled", "cancelled"
  role     OrderRole? @default(MAKER)
  timestamp DateTime @default(now())

  user     User   @relation(fields: [userId], references: [id])
  market   Market @relation(fields: [marketId], references: [id])

  buyTrades  Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")
  takerTrades Trade[] @relation("TakerOrder")
  makerTrades Trade[] @relation("MakerOrder")
}

model Trade {
  id       String   @id @default(uuid())
  marketId String
  price    Float
  size     Float
  buyOrderId String
  sellOrderId String
  takerOrderId String?
  makerOrderId String?
  timestamp DateTime @default(now())

  market   Market @relation(fields: [marketId], references: [id])
  buyOrder Order  @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order  @relation("SellOrder", fields: [sellOrderId], references: [id])
  takerOrder Order? @relation("TakerOrder", fields: [takerOrderId], references: [id])
  makerOrder Order? @relation("MakerOrder", fields: [makerOrderId], references: [id])
}

model Candle {
  id       String   @id @default(uuid())
  marketId  String
  resolution String @default("1m") // 1m everytime, and used to aggregate other candles (5m, 1h, 1d, etc.)
  timestamp BigInt // Unix timestamp in milliseconds
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float @default(0)

  market   Market @relation(fields: [marketId], references: [id])
}

// Not used
model Position {
  id        String   @id @default(uuid())
  userId    String
  marketId  String
  side      String   // e.g., "long" or "short"
  size      Float
  entryPrice Float
  timestamp DateTime @default(now())
}